# ============================================================
#  VILLAGE WEBSITE PLATFORM - Environment Configuration
#  Copy this file to `.env` and adjust the values.
# ============================================================

# ---- App ----
APP_NAME="Sistem Informasi Desa"
SITE_URL="http://localhost:3000"

# ---- Database (PostgreSQL) ----
# Any PostgreSQL-compatible URL. Swap this to point at a different DB / provider
# (Neon, Supabase, RDS, local docker) with no code changes.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/village_platform"

# ---- Authentication ----
# Generate a strong secret, e.g.  openssl rand -base64 48
JWT_SECRET="please-change-this-to-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Leave empty for localhost. Set to your apex domain in production, e.g. ".desa.id"
COOKIE_DOMAIN=""

# ---- Login protection ----
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW="900"

# ============================================================
#  STORAGE  -  choose ONE driver: local | s3 | supabase
# ============================================================
STORAGE_DRIVER="local"

# -- local driver --
STORAGE_LOCAL_DIR="./public/uploads"
STORAGE_PUBLIC_BASE="/uploads"

# -- s3 / s3-compatible (AWS S3, Cloudflare R2, MinIO, Wasabi, ...) --
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="village-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE="https://cdn.example.com"
S3_FORCE_PATH_STYLE="true"

# -- supabase storage (optional adapter) --
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="media"

# ============================================================
#  DEPLOYMENT
# ============================================================
# Nitro preset: node-server (VPS/Docker), vercel, netlify, ...
# Leave empty to auto-detect (Vercel sets this automatically).
NITRO_PRESET=""

# ---- Seed (used by `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@desa.local"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Administrator Desa"
