{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "database/**/*.ts",
    "drizzle.config.ts",
    "types/**/*.d.ts",
    "shared/**/*.ts",
    "config/**/*.ts"
  ]
}
